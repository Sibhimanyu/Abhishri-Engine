rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return exists(/databases/$(database)/documents/allowed_users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/allowed_users/$(request.auth.uid)).data 
        : (
            (request.auth.token.email != null && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())))
            ? get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data
            : (
                (request.auth.token.email != null && exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)))
                ? get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data
                : null
              )
          );
    }

    function isAdmin() {
      let doc = getUserDoc();
      return isAuthenticated() && doc != null && (doc.get('isAdmin', false) == true || doc.get('role', '') == 'admin');
    }

    function getRole() {
      let doc = getUserDoc();
      return (doc != null && doc.get('role', null) != null) ? doc.get('role', 'staff') : 'staff';
    }

    function isInternalStaff() {
      let doc = getUserDoc();
      let role = doc != null ? doc.get('role', 'staff') : '';
      return doc != null && role != 'student' && role != 'parent' && role != 'unauthorized';
    }

    function isOwnEmail(field) {
      return request.auth.token.email != null && field.lower() == request.auth.token.email.lower();
    }

    function hasAnyPerm(module) {
      let doc = getUserDoc();
      return doc != null && (doc.get('isAdmin', false) == true || doc.get('permissionGroup', null) != null);
    }

    function getPerm(module, action) {
      let doc = getUserDoc();
      let hasDirectPerm = doc != null && doc.get('permissions', null) != null && doc.get('permissions', {}).get(module, {}).get(action, false) == true;
      let role = (doc != null && doc.get('role', null) != null) ? doc.get('role', 'staff') : 'staff';
      let pGroup = /databases/$(database)/documents/permission_groups/$(role);
      
      let isPro = role == 'pro';
      let isTeach = role == 'teacher';
      let fallbackPerms = {
        'staff_directory': {'view': true, 'manage': isPro, 'delete': false},
        'student_directory': {'view': true, 'manage': isPro, 'delete': false},
        'attendance': {'view': true, 'mark': isTeach || isPro, 'edit': isPro},
        'fees_accounting': {'view': false, 'view_dashboard': false, 'config': false, 'ledger': false, 'trans_add': false, 'trans_delete': false, 'exp_own': true, 'exp_all': false, 'wallet_view_own': true, 'wallet_edit_own': false},
        'whatsapp_sender': {'access': false, 'broadcast': false, 'manage': false},
        'smart_campus': {'view': isPro, 'control': isPro, 'scenes': false, 'config': false}
      };
      let hasFallback = fallbackPerms.get(module, {}).get(action, false) == true;

      return doc != null && (
        doc.get('isAdmin', false) == true || 
        hasDirectPerm || 
        (
          exists(pGroup) ? get(pGroup).data.get('permissions', {}).get(module, {}).get(action, false) == true : hasFallback
        )
      );
    }

    function getStaffEmail(staffId) {
      return exists(/databases/$(database)/documents/allowed_users/$(staffId)) ? get(/databases/$(database)/documents/allowed_users/$(staffId)).data.get('email', '').lower() : '';
    }

    function isParentOf(studentId) {
      let email = request.auth.token.email;
      let inRoot = exists(/databases/$(database)/documents/students/$(studentId));
      let inStudent = exists(/databases/$(database)/documents/modules/student_directory/students/$(studentId));
      let inPreschool = exists(/databases/$(database)/documents/modules/preschool_directory/students/$(studentId));
      let inTuition = exists(/databases/$(database)/documents/modules/tuition_directory/students/$(studentId));
      
      let doc = inRoot ? get(/databases/$(database)/documents/students/$(studentId)) :
                inStudent ? get(/databases/$(database)/documents/modules/student_directory/students/$(studentId)) :
                inPreschool ? get(/databases/$(database)/documents/modules/preschool_directory/students/$(studentId)) :
                inTuition ? get(/databases/$(database)/documents/modules/tuition_directory/students/$(studentId)) :
                null;
                
      return doc != null && (
        doc.data.get('studentEmail', '') == email ||
        doc.data.get('motherEmail', '')  == email ||
        doc.data.get('fatherEmail', '')  == email
      );
    }

    // --- System Configurations & Aggregates ---
    match /configs/{configId} {
      allow read: if isAuthenticated() && (
        configId == 'whatsapp_main'
          ? (isAdmin() || getPerm('whatsapp_sender', 'manage'))
          : isAdmin()
      );
      allow write: if isAdmin() || (
        configId == 'whatsapp_main' && getPerm('whatsapp_sender', 'manage')
      );
    }
    
    match /attendance_aggregates/{aggregateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || getPerm('attendance', 'mark') || getPerm('attendance', 'edit');
    }

    // --- Flattened Root Collections (New Architecture) ---
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('student_directory', 'view') ||
        getPerm('fees_accounting', 'ledger') || getPerm('fees_accounting', 'view') ||
        getPerm('attendance', 'view') || getPerm('attendance', 'mark') || getPerm('attendance', 'edit') ||
        (resource != null && (
          resource.data.studentEmail == request.auth.token.email ||
          resource.data.motherEmail  == request.auth.token.email ||
          resource.data.fatherEmail  == request.auth.token.email
        ))
      );
      allow create, update: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'manage'));
      allow delete: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'delete'));
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        getPerm('staff_directory', 'view') || 
        getPerm('fees_accounting', 'wallet_view_own') || 
        getPerm('fees_accounting', 'exp_own') ||
        getPerm('attendance', 'view') || getPerm('attendance', 'mark') || getPerm('attendance', 'edit') ||
        (resource != null && isOwnEmail(resource.data.get('email', '')))
      );
      allow write: if isAdmin();
    }

    match /{path=**}/transactions/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger'));
    }

    match /students/{studentId}/transactions/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger') || isParentOf(studentId));
      allow create: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_add'));
      allow update: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_delete') || (getPerm('fees_accounting', 'trans_add') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided'])));
      allow delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_delete'));
    }

    match /students/{studentId}/fee_ledger/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger') || isParentOf(studentId));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
    }

    match /expenses/{id} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        getPerm('fees_accounting', 'exp_all') || 
        (resource != null && getPerm('fees_accounting', 'exp_own') && isOwnEmail(resource.data.get('createdBy', ''))) || 
        (resource != null && isInternalStaff() && (
          isOwnEmail(resource.data.get('createdBy', '')) ||
          isOwnEmail(resource.data.get('staffEmail', '')) ||
          (resource.data.get('staffId', '') != '' && getStaffEmail(resource.data.get('staffId', '')) == request.auth.token.email.lower())
        )) ||
        (resource != null && getPerm('fees_accounting', 'wallet_view_own') && (
          isOwnEmail(resource.data.get('createdBy', '')) || 
          isOwnEmail(resource.data.get('staffEmail', '')) || 
          (resource.data.get('staffId', '') != '' && getStaffEmail(resource.data.get('staffId', '')) == request.auth.token.email.lower())
        ))
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        getPerm('fees_accounting', 'exp_all') || 
        getPerm('fees_accounting', 'exp_own') || 
        getPerm('fees_accounting', 'wallet_edit_own') ||
        (isInternalStaff() && isOwnEmail(request.resource.data.get('createdBy', '')))
      );
      allow update, delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'exp_all') || getPerm('fees_accounting', 'wallet_edit_own'));
    }

    match /fee_plans/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'config'));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
    }

    match /student_fees/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger') || isParentOf(id));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
    }

    match /collections/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger') || (resource != null && isParentOf(resource.data.get('studentId', ''))));
      allow create: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_add'));
      allow update, delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_delete') || getPerm('fees_accounting', 'trans_add'));
    }

    match /salaries/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'salaries_view') || (getPerm('fees_accounting', 'wallet_view_own') && request.auth.token.email.lower() == getStaffEmail(id)));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'salaries_process')); 
    }

    match /staff_wallets/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view'));
      allow write: if isAuthenticated() && isAdmin();
    }

    match /permission_groups/{role} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }



    match /configs/whatsapp_main/templates/{templateId} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access') || getPerm('whatsapp_sender', 'manage') || getPerm('whatsapp_sender', 'broadcast'));
      allow write: if isAdmin() || getPerm('whatsapp_sender', 'manage');
    }

    // --- Audit Logs (System Wide) ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); 
    }


    
    // --- Users (Unified Staff & Auth) ---
    match /allowed_users/{id} {
      allow read: if isAuthenticated() && (
        id == request.auth.uid || 
        id == request.auth.token.email ||
        id == request.auth.token.email.lower() ||
        (resource != null && resource.data.get('email', '') != '' && resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
        isAdmin() || 
        getPerm('staff_directory', 'view') || 
        getPerm('fees_accounting', 'wallet_view_own') || 
        getPerm('fees_accounting', 'exp_own')
      );
      allow write: if isAdmin() || (
        (getPerm('staff_directory', 'manage') || getPerm('staff_directory', 'add')) &&
        (!request.resource.data.keys().hasAll(['isAdmin']) || request.resource.data.isAdmin == false) &&
        (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role != 'admin')
      );
      allow delete: if isAdmin() || getPerm('staff_directory', 'delete');
    }
    
    // --- Unauthorized Logins ---
    match /unauthorized_logins/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // --- School Calendar ---
    match /school_calendar/{dateId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || isInternalStaff());
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
