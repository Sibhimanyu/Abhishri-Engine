rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // The signed-in email, lowercased, but only once the account has proven it owns that
    // inbox; '' otherwise. Email/password accounts can be created by anyone through the
    // public API, so an unverified email must never unlock an allowed_users record keyed
    // by that address, or anyone could sign up as a staff member who hasn't yet.
    // Google accounts are always verified; password accounts become verified by setting
    // their password from the emailed link (Login -> "Set or reset password").
    // Phone sign-in is for parents only, so a phone session never counts as staff, even
    // on an account that somehow also has an email.
    function authEmail() {
      return request.auth != null
          && !isPhoneSession()
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', null) != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isPhoneSession() {
      return request.auth.token.firebase.sign_in_provider == 'phone';
    }

    // Firestore stops evaluating a request after 1000 expressions, and helpers are
    // re-evaluated on every call (nothing is cached), so these are written to do as little
    // as possible per call: authEmail() once per lookup, and the built-in role defaults only
    // when a role has no permission_groups document. Expense writes call getPerm() several
    // times and went over the limit when each call rebuilt everything.
    function getUserDoc() {
      return isPhoneSession() ? null : userDocFor(authEmail());
    }

    function userDocFor(email) {
      return exists(/databases/$(database)/documents/allowed_users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/allowed_users/$(request.auth.uid)).data
        : (
            (email != '' && exists(/databases/$(database)/documents/allowed_users/$(email)))
            ? get(/databases/$(database)/documents/allowed_users/$(email)).data
            : null
          );
    }

    function isAdmin() {
      let doc = getUserDoc();
      return isAuthenticated() && doc != null && (doc.get('isAdmin', false) == true || doc.get('role', '') == 'admin');
    }

    function getRole() {
      let doc = getUserDoc();
      return (doc != null && doc.get('role', null) != null) ? doc.get('role', 'staff') : 'staff';
    }

    function isInternalStaff() {
      let doc = getUserDoc();
      let role = doc != null ? doc.get('role', 'staff') : '';
      return doc != null && role != 'student' && role != 'parent' && role != 'unauthorized';
    }

    function isOwnEmail(field) {
      return authEmail() != '' && field.lower() == authEmail();
    }

    function hasAnyPerm(module) {
      let doc = getUserDoc();
      return doc != null && (doc.get('isAdmin', false) == true || doc.get('permissionGroup', null) != null);
    }

    function getPerm(module, action) {
      let doc = getUserDoc();
      return doc != null && permFor(doc, module, action);
    }

    function permFor(doc, module, action) {
      let role = doc.get('role', null) != null ? doc.get('role', 'staff') : 'staff';
      let pGroup = /databases/$(database)/documents/permission_groups/$(role);
      return doc.get('isAdmin', false) == true ||
        doc.get('permissions', {}).get(module, {}).get(action, false) == true ||
        (exists(pGroup)
          ? get(pGroup).data.get('permissions', {}).get(module, {}).get(action, false) == true
          : defaultPerm(role, module, action));
    }

    // Built-in permissions for a role with no permission_groups document. Mirrors
    // defaultPermissions() in AuthContext.jsx and FALLBACK in functions/src/shared/access.js.
    function defaultPerm(role, module, action) {
      let isPro = role == 'pro';
      let isTeach = role == 'teacher';
      return {
        'staff_directory': {'view': !isTeach, 'manage': isPro, 'delete': false},
        'student_directory': {'view': true, 'manage': isPro, 'delete': false},
        'attendance': {'view': true, 'mark': isTeach || isPro, 'edit': isPro},
        'fees_accounting': {'view': false, 'view_dashboard': false, 'config': false, 'ledger': false, 'trans_add': false, 'trans_delete': false, 'exp_own': !isTeach, 'exp_all': false, 'wallet_view_own': !isTeach, 'wallet_edit_own': false},
        'whatsapp_sender': {'access': false, 'broadcast': false, 'manage': false},
        'smart_campus': {'view': isPro, 'control': isPro, 'scenes': false, 'config': false}
      }.get(module, {}).get(action, false) == true;
    }

    // Resolve a staff member's email from the SAME collection their wallet lives in
    // (staff/{staffId}.walletBalance, written by syncStaffWalletBalance). Reading this from
    // allowed_users was wrong twice over: that collection is writable by any
    // staff_directory.manage holder, so the identity behind a money check was attacker-
    // controllable; and onUserCreated migrates allowed_users/{email} -> allowed_users/{uid}
    // and deletes the email-keyed doc, which would make this return '' for every migrated
    // user and silently deny their own legitimate wallet writes.
    function getStaffEmail(staffId) {
      return exists(/databases/$(database)/documents/staff/$(staffId))
        ? get(/databases/$(database)/documents/staff/$(staffId)).data.get('email', '').lower()
        : '';
    }

    // A staff_wallet expense drives staff/{staffId}.walletBalance via the syncStaffWalletBalance
    // trigger. A caller without "exp_all" may only file one against their OWN staff record, and
    // may never file a 'funding' entry: funding is money granted TO a staff member by finance,
    // so permitting it here would let any account (exp_own defaults to true for EVERY role, see
    // fallbackPerms above) credit its own wallet by an arbitrary amount. Non-wallet expenses are
    // unaffected. staffId must be non-empty or the exists() path below would be malformed.
    function isSelfTargetedWalletWrite(data) {
      let staffId = data.get('staffId', '');
      return data.get('source', '') != 'staff_wallet' || (
        staffId != '' &&
        authEmail() != '' && getStaffEmail(staffId) == authEmail() &&
        data.get('type', '') != 'funding'
      );
    }

    // Students live in ONE place: /students. Three legacy fallbacks
    // (modules/{student,preschool,tuition}_directory/students) were checked here
    // before falling through to it, costing 4 exists() + 1 get() per call.
    //
    // That mattered beyond tidiness. Rules allow only 10 document accesses per
    // single-document request, and the read rules that call this also evaluate
    // isAdmin() + getPerm() (allowed_users lookup + permission_groups). At 5
    // accesses this function could push a portal user reading their own
    // transaction over the limit, denying access outright. It is now 2.
    //
    // Verified against production before removing: Firestore has no "modules"
    // collection at all, and all three legacy student paths return zero docs.
    // A closed accounting period is frozen: reconciling a month is meaningless if the
    // month can still move afterwards. Payments carrying a closed periodKey are refused,
    // so a later correction must be posted as an adjustment in the OPEN period instead
    // of silently rewriting a signed-off one. Unset/blank periodKey (legacy rows written
    // before Phase 1) is treated as open so nothing that exists today becomes unwritable.
    function isPeriodOpen(periodKey) {
      return periodKey == null
        || periodKey == ''
        || !exists(/databases/$(database)/documents/periods/$(periodKey))
        || get(/databases/$(database)/documents/periods/$(periodKey)).data.get('status', 'open') != 'closed';
    }

    // Parents don't read Firestore directly: they sign in by phone and the
    // getParentPortal/getParentAttendance callables return only the fields the school
    // chose to show them (functions/src/students/portal.js). Rules can only allow a
    // whole student document, which would hand parents Aadhaar, address and medical
    // notes along with the basics.

    // Parent portal access is an admin decision (setParentPortalAccess), and
    // portalPhones is derived from the record by syncStudentPortalPhones. A
    // student_directory manager editing a profile must not be able to touch either,
    // or they could restore a parent an admin removed.
    function touchesPortalAccess(keys) {
      return keys.hasAny(['portalAccess', 'portalPhones']);
    }

    // --- System Configurations & Aggregates ---
    match /configs/{configId} {
      allow read: if isAuthenticated() && (
        configId == 'whatsapp_main'
          ? (isAdmin() || getPerm('whatsapp_sender', 'manage'))
          : isAdmin()
      );
      allow write: if isAdmin() || (
        configId == 'whatsapp_main' && getPerm('whatsapp_sender', 'manage')
      );
    }
    
    // --- Flattened Root Collections (New Architecture) ---
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('student_directory', 'view') ||
        getPerm('fees_accounting', 'ledger') || getPerm('fees_accounting', 'view') ||
        getPerm('attendance', 'view') || getPerm('attendance', 'mark') || getPerm('attendance', 'edit')
      );
      allow create: if isAuthenticated() && (isAdmin() || (
        getPerm('student_directory', 'manage') && !touchesPortalAccess(request.resource.data.keys())
      ));
      allow update: if isAuthenticated() && (isAdmin() || (
        getPerm('student_directory', 'manage') && !touchesPortalAccess(request.resource.data.diff(resource.data).affectedKeys())
      ));
      allow delete: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'delete'));
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        getPerm('staff_directory', 'view') ||
        // Fees screens that work across staff (all wallets, all transactions, reports).
        getPerm('fees_accounting', 'exp_all') || getPerm('fees_accounting', 'view') ||
        getPerm('fees_accounting', 'ledger') || getPerm('fees_accounting', 'view_dashboard') ||
        // Everyone else (e.g. teachers, who don't get the staff directory) only their own
        // record, which My Expenses looks up by email. Own-expense/own-wallet rights and
        // attendance rights used to open every staff record.
        (resource != null && isOwnEmail(resource.data.get('email', ''))) ||
        // The same, in the plain form a query (where email == mine) can be checked against;
        // staff emails are stored lowercase.
        (authEmail() != '' && resource.data.email == authEmail())
      );
      allow write: if isAdmin();
    }

    match /{path=**}/transactions/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger'));
    }

    match /students/{studentId}/transactions/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger'));
      allow create: if isAuthenticated()
        && (isAdmin() || getPerm('fees_accounting', 'trans_add'))
        && isPeriodOpen(request.resource.data.get('periodKey', null));
      // APPEND-ONLY LEDGER (docs/payments-data-model-review.md phase 3).
      // A posted payment is never rewritten. The only permitted mutation is flipping
      // isVoided, which is how both voiding and correcting work: the correction posts a
      // reversal row plus a replacement payment instead of editing in place, so a period
      // that has already been reconciled cannot change underneath you.
      allow update: if isAuthenticated()
        && (isAdmin() || getPerm('fees_accounting', 'trans_delete') || getPerm('fees_accounting', 'trans_add'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided']);
      // Deleting is deliberately reserved for administrators. The client presents a
      // confirmation dialog and records the action in audit_logs.
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Cash settlement. Written only by the createDeposit callable (Admin SDK, bypasses
    // rules); membership lives in deposit_lines keyed by payment id, deliberately NOT as
    // a field on the payment, because the ledger has been append-only since phase 3.
    match /deposits/{depositId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'view_dashboard') ||
        getPerm('fees_accounting', 'view') ||
        getPerm('fees_accounting', 'ledger') ||
        getPerm('fees_accounting', 'config')
      );
      allow write: if false;
    }
    match /deposits/{depositId}/deposit_lines/{paymentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'view_dashboard') ||
        getPerm('fees_accounting', 'view') ||
        getPerm('fees_accounting', 'ledger') ||
        getPerm('fees_accounting', 'config')
      );
      allow write: if false;
    }

    // Bank reconciliation runs and their statement lines. Written only by the
    // importStatement / autoMatchStatement / setStatementLineMatch callables (Admin SDK,
    // rules-bypassing): a bank statement is evidence, so the client never edits it in place.
    match /reconciliations/{runId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'ledger') ||
        getPerm('fees_accounting', 'config') ||
        getPerm('fees_accounting', 'view')
      );
      allow write: if false;
    }
    match /reconciliations/{runId}/lines/{lineId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'ledger') ||
        getPerm('fees_accounting', 'config') ||
        getPerm('fees_accounting', 'view')
      );
      allow write: if false;
    }

    // Accounting periods. Written only by the closePeriod/reopenPeriod callables, which
    // run with the Admin SDK and bypass rules; the client reads them to show whether a
    // month is signed off.
    match /periods/{periodKey} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'view_dashboard') ||
        getPerm('fees_accounting', 'view') ||
        getPerm('fees_accounting', 'ledger') ||
        getPerm('fees_accounting', 'config')
      );
      allow write: if false;
    }

    // --- Payments journal (migration 002; see docs/payments-data-model-review.md) ---
    // Derived, append-only records. The client never writes them: they are produced by
    // migrations and Cloud Functions, both of which use the Admin SDK and bypass rules
    // entirely. Read access mirrors the transactions rule so the reconciliation screens
    // can be built without widening who can see fee data.
    //
    // Note the catch-all at the bottom of this file still grants admins write access,
    // deliberately — an admin needs a way to correct the journal. This block exists to
    // grant READ to non-admin fee staff, which the catch-all alone would not.
    match /allocations/{allocationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'view_dashboard') ||
        getPerm('fees_accounting', 'view') ||
        getPerm('fees_accounting', 'ledger')
      );
      allow write: if false;
    }

    // Immutable snapshots of a student's fee plan. Allocations reference a version id so
    // that editing a plan can never again orphan the component a payment was applied to.
    match /students/{studentId}/fee_plan_versions/{versionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'view_dashboard') ||
        getPerm('fees_accounting', 'view') ||
        getPerm('fees_accounting', 'ledger') ||
        getPerm('fees_accounting', 'config')
      );
      allow write: if false;
    }

    match /students/{studentId}/fee_ledger/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger'));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
    }

    match /expenses/{id} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        getPerm('fees_accounting', 'exp_all') || 
        (resource != null && getPerm('fees_accounting', 'exp_own') && isOwnEmail(resource.data.get('createdBy', ''))) || 
        (resource != null && isInternalStaff() && (
          isOwnEmail(resource.data.get('createdBy', '')) ||
          isOwnEmail(resource.data.get('staffEmail', '')) ||
          (resource.data.get('staffId', '') != '' && authEmail() != '' && getStaffEmail(resource.data.get('staffId', '')) == authEmail())
        )) ||
        (resource != null && getPerm('fees_accounting', 'wallet_view_own') && (
          isOwnEmail(resource.data.get('createdBy', '')) || 
          isOwnEmail(resource.data.get('staffEmail', '')) || 
          (resource.data.get('staffId', '') != '' && authEmail() != '' && getStaffEmail(resource.data.get('staffId', '')) == authEmail())
        ))
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'exp_all') ||
        (
          // Non-"exp_all" holders may only create records attributed to themselves.
          // Logging expenses is an accounting permission; roles without it (teachers) can't,
          // even for themselves.
          (getPerm('fees_accounting', 'exp_own') || getPerm('fees_accounting', 'wallet_edit_own')) &&
          isOwnEmail(request.resource.data.get('createdBy', '')) &&
          // A staff_wallet-sourced expense must target the caller's OWN staff record and must
          // not be a 'funding' entry — otherwise any staff account could fund/drain another
          // staff member's wallet, or simply credit its own. See isSelfTargetedWalletWrite.
          isSelfTargetedWalletWrite(request.resource.data)
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'exp_all') ||
        (
          // "exp_own"/"wallet_edit_own" holders may edit only records THEY created, and can't
          // reassign ownership or re-target a staff_wallet expense at someone else's staffId —
          // otherwise "edit your own expense" would reopen the wallet-spoofing hole create closes.
          (getPerm('fees_accounting', 'exp_own') || getPerm('fees_accounting', 'wallet_edit_own')) &&
          resource != null && isOwnEmail(resource.data.get('createdBy', '')) &&
          isOwnEmail(request.resource.data.get('createdBy', '')) &&
          isSelfTargetedWalletWrite(request.resource.data)
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        getPerm('fees_accounting', 'exp_all') ||
        (
          (getPerm('fees_accounting', 'exp_own') || getPerm('fees_accounting', 'wallet_edit_own')) &&
          resource != null && isOwnEmail(resource.data.get('createdBy', ''))
        )
      );
    }

    match /fee_plans/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'config'));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
    }

    match /student_fees/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger'));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
    }

    match /collections/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view') || getPerm('fees_accounting', 'ledger'));
      allow create: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_add'));
      // "trans_add" is meant to let a role record NEW collections, not edit/delete existing
      // receipts — that must go through "trans_delete" (matching students/{id}/transactions).
      allow update, delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_delete'));
    }

    match /salaries/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'salaries_view') || (getPerm('fees_accounting', 'wallet_view_own') && authEmail() != '' && authEmail() == getStaffEmail(id)));
      allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'salaries_process')); 
    }

    match /staff_wallets/{id} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view_dashboard') || getPerm('fees_accounting', 'view'));
      allow write: if isAuthenticated() && isAdmin();
    }

    match /permission_groups/{role} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }



    match /configs/whatsapp_main/templates/{templateId} {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access') || getPerm('whatsapp_sender', 'manage') || getPerm('whatsapp_sender', 'broadcast'));
      allow write: if isAdmin() || getPerm('whatsapp_sender', 'manage');
    }

    // --- Audit Logs (System Wide) ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Require honest attribution — otherwise any authenticated user could inject an
      // unattributed or spoofed entry blaming another user's email for an action they
      // didn't perform, undermining the log's value as a record of what actually happened.
      allow create: if isAuthenticated() &&
        request.resource.data.get('action', '') is string &&
        request.resource.data.get('action', '') != '' &&
        isOwnEmail(request.resource.data.get('performedBy', ''));
    }


    
    // --- Users (Unified Staff & Auth) ---
    match /allowed_users/{id} {
      allow read: if isAuthenticated() && (
        id == request.auth.uid || 
        (authEmail() != '' && id == authEmail()) ||
        (resource != null && authEmail() != '' && resource.data.get('email', '').lower() == authEmail()) ||
        isAdmin() || 
        getPerm('staff_directory', 'view') || 
        getPerm('fees_accounting', 'wallet_view_own') || 
        getPerm('fees_accounting', 'exp_own')
      );
      allow write: if isAdmin() || (
        (getPerm('staff_directory', 'manage') || getPerm('staff_directory', 'add')) &&
        // Direct "permissions" overrides are admin-only — otherwise any manager/add-holder
        // could grant themselves (or anyone) arbitrary module permissions (e.g. fees delete/config)
        // without ever touching the isAdmin/role fields this rule already guards.
        !request.resource.data.keys().hasAny(['permissions']) &&
        (!request.resource.data.keys().hasAll(['isAdmin']) || request.resource.data.isAdmin == false) &&
        (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role != 'admin')
      );
      // A non-admin "delete" holder still cannot remove an admin's own access record (lockout/DoS guard).
      allow delete: if isAdmin() || (
        getPerm('staff_directory', 'delete') &&
        resource.data.get('isAdmin', false) != true &&
        resource.data.get('role', '') != 'admin'
      );
    }
    
    // --- Unauthorized Logins ---
    match /unauthorized_logins/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // --- School Calendar ---
    match /school_calendar/{dateId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || isInternalStaff());
    }

    // Weekly menus and daily reports need an admin's approval before a non-admin may
    // export them (frontend/src/components/poster/approval.js). A non-admin can save a
    // draft or send it for approval, attributed to themselves, but never write any
    // other status: approving, and sending back with a note, are admin-only.
    function isNonAdminPosterWrite() {
      let approval = request.resource.data.get('approval', {});
      let status = approval.get('status', 'draft');
      return status in ['draft', 'pending'] &&
        (status != 'pending' || isOwnEmail(approval.get('requestedBy', '')));
    }

    // --- Weekly Menus ---
    match /weekly_menus/{menuId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isAdmin() || (isInternalStaff() && isNonAdminPosterWrite()));
      allow delete: if isAuthenticated() && (isAdmin() || isInternalStaff());
    }

    // --- Daily Reports ("Connecting the Dots"), one per date: doc id is YYYY-MM-DD ---
    match /daily_reports/{date} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isAdmin() || (isInternalStaff() && isNonAdminPosterWrite()));
      allow delete: if isAuthenticated() && (isAdmin() || isInternalStaff());
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
