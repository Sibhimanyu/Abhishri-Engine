rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for the new modular structure
    match /modules/whatsapp_sender {
      match /config/{configId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
      
      match /lists/{listId} {
        allow read, write: if isAuthenticated();
        
        match /members/{memberId} {
          allow read, write: if isAuthenticated();
        }
      }
      
      match /history/{historyId} {
        allow read, write: if isAuthenticated();
      }

      match /templates/{templateId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
    }

    // --- Student Directory Module ---
    match /modules/student_directory {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'view'));
      
      match /students/{studentId} {
        allow create, update, delete: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'manage'));
        
        match /performance_logs/{logId} {
          allow read: if isAuthenticated() && (isAdmin() || getPerm('student_performance', 'view'));
          allow write: if isAuthenticated() && (isAdmin() || getPerm('student_performance', 'manage'));
        }
      }
    }

    // --- Staff Directory Module ---
    match /modules/staff_directory {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
      
      match /staff/{staffId} {
        allow create, update, delete: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'manage'));
        
        match /performance_logs/{logId} {
          allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
          allow write: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'pulse'));
        }
      }
    }

    match /modules/smart_campus {
      match /areas/{areaId} {
        allow read, write: if isAuthenticated();
      }
      match /config/{id} {
        allow read, write: if isAuthenticated();
      }
      match /logs/{id} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- Fees & Accounting Module ---
    match /modules/fees_accounting {
      allow read, write: if isAuthenticated();
      match /{allPaths=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- Global Collections ---
    match /allowedUsers/{email} {
      // Allow any authenticated user to check their own status
      allow read: if request.auth != null && (request.auth.token.email.lower() == email.lower() || isAdmin());
      
      // Allow creation if:
      // 1. User is auto-provisioning themselves from an allowed domain
      // 2. An existing admin is manually authorizing a new email
      allow create: if request.auth != null && (
        (request.auth.token.email.lower() == email.lower() && (
          email.lower().endsWith('@abhishriacademy.in') || 
          email.lower().endsWith('@zoho.com') || 
          email.lower().endsWith('@zoho.in') ||
          email.lower() == 'sibhi.gv@gmail.com'
        )) || isAdmin()
      );

      // Only admins can update or delete users
      allow update, delete: if isAdmin();
    }

    // Helper for Admin check
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.isAdmin == true;
    }

    // Helper for granular permission check
    function getPerm(module, action) {
      return get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.permissions[module][action] == true;
    }
  }
}
