rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for the new modular structure
    match /modules/whatsapp_sender {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
      
      match /config/{configId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && isAdmin();
      }
      
      match /lists/{listId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
        
        match /members/{memberId} {
          allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
          allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
        }
      }
      
      match /history/{historyId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
      }

      match /templates/{templateId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
      }
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
    }

    // --- Audit Logs (System Wide) ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Logic in functions/code ensures users can only write, not edit
    }

    // --- Student Directory Module ---
    match /modules/student_directory {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'view'));
      
      match /students/{studentId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'view'));
        allow create, update, delete: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'manage'));
      }

      match /performance_logs/{logId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('student_performance', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('student_performance', 'log'));
        allow delete: if isAdmin();
      }
    }

    // --- Staff Directory Module ---
    match /modules/staff_directory {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
      
      match /staff/{staffId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
        allow create, update, delete: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'manage'));
      }

      match /performance_logs/{logId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'pulse'));
        allow delete: if isAdmin();
      }
    }

    match /modules/smart_campus {
      match /areas/{areaId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'control'));
      }
      match /config/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated() && isAdmin();
      }
      match /logs/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated();
      }
    }

    // --- Fees & Accounting Module ---
    match /modules/fees_accounting {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
      
      match /collections/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'transactions'));
      }
      match /student_fees/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'ledger'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'transactions'));
      }
      match /transactions/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'transactions'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'transactions'));
      }
      match /plans/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
      }
      match /expenses/{id} {
        allow read: if isAuthenticated() && (
          isAdmin() || 
          getPerm('fees_accounting', 'expenses_all') || 
          (getPerm('fees_accounting', 'expenses') && resource.data.createdBy == request.auth.token.email.lower())
        );
        allow create: if isAuthenticated() && (getPerm('fees_accounting', 'expenses') || getPerm('fees_accounting', 'fund_staff'));
        allow delete: if isAuthenticated() && (isAdmin() || resource.data.createdBy == request.auth.token.email.lower());
      }

      match /{allPaths=**} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow write: if isAuthenticated() && isAdmin();
      }
    }

    // --- Global Collections ---
    match /allowedUsers/{email} {
      // Allow any authenticated user to check their own status
      allow read: if request.auth != null && (request.auth.token.email.lower() == email.lower() || isAdmin());
      
      // Allow creation if:
      // 1. User is auto-provisioning themselves from an allowed domain
      // 2. An existing admin is manually authorizing a new email
      allow create: if request.auth != null && (
        (request.auth.token.email.lower() == email.lower() && (
          email.lower().endsWith('@abhishriacademy.in') || 
          email.lower().endsWith('@zoho.com') || 
          email.lower().endsWith('@zoho.in') ||
          email.lower() == 'sibhi.gv@gmail.com'
        )) || isAdmin()
      );

      // Only admins can update or delete users
      allow update, delete: if isAdmin();
    }

    // Helper for Admin check
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.isAdmin == true;
    }

    // Helper for granular permission check
    function getPerm(module, action) {
      return get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.permissions[module][action] == true;
    }
  }
}