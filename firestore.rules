rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for the new modular structure
    match /modules/whatsapp_sender {
      allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
      
      match /config/{configId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && isAdmin();
      }
      
      match /lists/{listId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
        
        match /members/{memberId} {
          allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
          allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
        }
      }
      
      match /history/{historyId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
      }

      match /templates/{templateId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'access'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('whatsapp_sender', 'manage'));
      }
    }

    // --- Audit Logs (System Wide) ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); 
    }

    // --- Student Directory Module ---
    match /modules/student_directory {
      allow read: if isAuthenticated() && (isAdmin() || hasAnyPerm('student_directory'));
      
      match /students/{studentId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'add'));
        allow update: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'edit'));
        allow delete: if isAuthenticated() && (isAdmin() || getPerm('student_directory', 'delete'));
      }

      match /performance_logs/{logId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('student_performance', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('student_performance', 'log'));
        allow delete: if isAdmin();
      }
    }

    // --- Staff Directory Module ---
    match /modules/staff_directory {
      allow read: if isAuthenticated() && (isAdmin() || hasAnyPerm('staff_directory'));
      
      match /staff/{staffId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'add'));
        allow update: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'edit'));
        allow delete: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'delete'));
      }

      match /performance_logs/{logId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('staff_directory', 'pulse'));
        allow delete: if isAdmin();
      }
    }

    match /modules/smart_campus {
      allow read: if isAuthenticated() && (isAdmin() || hasAnyPerm('smart_campus'));
      
      match /areas/{areaId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'control'));
      }
      match /scenes/{sceneId} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'scenes'));
      }
      match /config/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated() && isAdmin();
      }
      match /logs/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('smart_campus', 'view'));
        allow write: if isAuthenticated();
      }
    }

    // --- Fees & Accounting Module ---
    match /modules/fees_accounting {
      allow read: if isAuthenticated() && (isAdmin() || hasAnyPerm('fees_accounting'));
      
      match /collections/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_add'));
        allow update, delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_delete'));
      }
      match /student_fees/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'ledger'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_add'));
      }
      match /transactions/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow create: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_add'));
        allow update, delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'trans_delete'));
      }
      match /plans/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'config'));
      }
      match /expenses/{id} {
        allow read: if isAuthenticated() && (
          isAdmin() || 
          getPerm('fees_accounting', 'exp_all') || 
          (getPerm('fees_accounting', 'exp_own') && resource.data.createdBy == request.auth.token.email.lower())
        );
        allow create: if isAuthenticated() && (
          isAdmin() || 
          getPerm('fees_accounting', 'exp_all') || 
          getPerm('fees_accounting', 'exp_own')
        ) && request.resource.data.createdBy == request.auth.token.email.lower() && request.resource.data.source == 'office';
        
        allow update, delete: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'exp_all'));
      }
      
      match /salaries/{id} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'salaries_view'));
        allow write: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'salaries_process'));
      }

      match /{allPaths=**} {
        allow read: if isAuthenticated() && (isAdmin() || getPerm('fees_accounting', 'view'));
        allow write: if isAuthenticated() && isAdmin();
      }
    }

    // --- Global Collections ---
    match /allowedUsers/{email} {
      // Allow any authenticated user to check their own status
      allow read: if request.auth != null && (request.auth.token.email.lower() == email.lower() || isAdmin());
      
      // Allow creation if:
      // 1. User is auto-provisioning themselves from an allowed domain
      // 2. An existing admin is manually authorizing a new email
      allow create: if request.auth != null && (
        (request.auth.token.email.lower() == email.lower() && (
          email.lower().matches('.*@abhishri\\.edu\\.in')
        )) || isAdmin()
      );

      // Only admins can update or delete users
      allow update, delete: if isAdmin();
    }

    // Helper for Admin check
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.isAdmin == true;
    }

    // Helper for granular permission check
    function getPerm(module, action) {
      let p = get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.permissions[module];
      return p == true || (p != null && p[action] == true);
    }

    // Helper to check if any permission exists for a module
    function hasAnyPerm(module) {
      let p = get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.permissions[module];
      return p == true || (p != null && p.keys().size() > 0);
    }
  }
}