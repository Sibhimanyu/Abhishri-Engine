{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "whatsapp_debug_webhooks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "whatsapp_conversations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$recipientId": {
        "metadata": {
          ".indexOn": ["timestamp"]
        },
        "messages": {
          ".indexOn": ["messageId", "timestamp"]
        }
      }
    },
    "whatsapp_broadcast_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$broadcastId": {
        ".indexOn": ["messageId", "timestamp"]
      }
    },
    "whatsapp_batch_map": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "modules": {
      "smart_campus": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "student_directory": {
        "attendance": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "staff_directory": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "fees_accounting": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
