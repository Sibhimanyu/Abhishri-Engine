{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "modules": {
      "smart_campus": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "student_directory": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "staff_directory": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "whatsapp_sender": {
        ".read": "auth != null",
        ".write": "auth != null",
        "conversations": {
          "$recipientId": {
            "metadata": {
              ".indexOn": ["timestamp"]
            },
            "messages": {
              ".indexOn": ["messageId", "timestamp"]
            }
          }
        },
        "broadcast_logs": {
          "$broadcastId": {
            ".indexOn": ["messageId", "timestamp"]
          }
        },
        "batch_map": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "fees_accounting": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
